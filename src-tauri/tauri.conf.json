{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Silvernote",
  "version": "0.1.0",
  "identifier": "com.tauri.dev",
  "build": {
    "frontendDist": "../../silvernote_app/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "cd /home/moi/Documents/GitHub/silvernote_app && npm run dev",
    "beforeBuildCommand": "cd /home/moi/Documents/GitHub/silvernote_app && npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Silvernote",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
